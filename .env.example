# Lyftr AI LLM Gateway Environment Configuration

# Comma-separated API key pool. Key IDs will be assigned sequentially as key_1, key_2, ...
# Example with Google Gemini keys:
LLM_API_KEYS=your_primary_gemini_api_key,your_secondary_gemini_api_key

# SQLite location (use sqlite:////data/app.db inside Docker for volume persistence)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-deployment.vercel.app

# Enable failover test hook (X-Simulate-Failure header support)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM model provider and model name
DEFAULT_MODEL=gemini/gemini-2.0-flash

# Default fallback system prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, brilliant, and concise AI assistant.

# Frontend API URL configuration
VITE_BACKEND_URL=http://localhost:8000
